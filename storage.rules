rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Allow customers to upload print documents (PDF, Word, Images up to 50MB)
    match /shops/{shopId}/uploads/{allPaths=**} {
      // Public read for printing and previewing
      allow read: if true;
      // Allow upload if file is under 50MB
      allow write: if request.resource.size < 50 * 1024 * 1024;
    }

    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 50 * 1024 * 1024;
    }

    // Default match
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null || request.resource.size < 50 * 1024 * 1024;
    }
  }
}
