generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Shop {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  phone        String
  email        String
  address      String?       @db.Text
  city         String?
  state        String?
  pincode      String?
  gstNumber    String?
  qrCodeUrl    String?       @db.Text
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  auditLogs    AuditLog[]
  customers    Customer[]
  orders       Order[]
  pricingRules PricingRule[]
  printAgents  PrintAgent[]
  printers     Printer[]
  subscription Subscription?
  users        User[]

  @@map("shops")
}

model User {
  id           String     @id @default(cuid())
  shopId       String?
  email        String     @unique
  passwordHash String
  fullName     String
  phone        String?
  role         String     @default("SHOP_OWNER")
  isVerified   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
  shop         Shop?      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId], map: "users_shopId_fkey")
  @@map("users")
}

model Customer {
  id        String   @id @default(cuid())
  shopId    String
  phone     String   @unique
  fullName  String
  email     String?
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@index([shopId, phone])
  @@map("customers")
}

model Order {
  id               String          @id @default(cuid())
  orderNumber      String          @unique
  shopId           String
  customerId       String
  customerPhone    String?
  status           String          @default("SUBMITTED")
  paymentStatus    String          @default("PENDING")
  paymentMethod    String?
  paymentReference String?
  paidAt           DateTime?
  totalDocuments   Int             @default(1)
  totalPages       Int             @default(1)
  estimatedAmount  Float           @default(0)
  finalAmount      Float?
  customerNotes    String?         @db.Text
  rejectionReason  String?         @db.Text
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  documents        OrderDocument[]
  customer         Customer        @relation(fields: [customerId], references: [id])
  shop             Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  printJobs        PrintJob[]

  @@index([shopId, status])
  @@index([customerPhone])
  @@index([customerId], map: "orders_customerId_fkey")
  @@map("orders")
}

model OrderDocument {
  id                String             @id @default(cuid())
  orderId           String
  originalFilename  String
  storageKey        String             @db.VarChar(512)
  fileSizeBytes     Int
  mimeType          String
  sha256Checksum    String
  detectedPageCount Int                @default(1)
  previewImageKey   String?            @db.Text
  createdAt         DateTime           @default(now())
  specs             DocumentPrintSpec?
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  printJobs         PrintJob[]

  @@index([orderId], map: "order_documents_orderId_fkey")
  @@map("order_documents")
}

model DocumentPrintSpec {
  id             String        @id @default(cuid())
  documentId     String        @unique
  copies         Int           @default(1)
  color          String        @default("BW")
  duplex         String        @default("SIMPLEX")
  paperSize      String        @default("A4")
  orientation    String        @default("AUTO")
  pageRange      String        @default("ALL")
  pagesPerSheet  Int           @default(1)
  collate        Boolean       @default(true)
  stapling       String        @default("NONE")
  binding        String        @default("NONE")
  lamination     String        @default("NONE")
  finishingNotes String?       @db.Text
  priceDetails   String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  document       OrderDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_print_specs")
}

model PrintAgent {
  id              String     @id @default(cuid())
  shopId          String
  agentName       String
  machineHostname String?
  osVersion       String?
  ipAddress       String?
  authTokenHash   String
  isConnected     Boolean    @default(false)
  lastHeartbeatAt DateTime?
  createdAt       DateTime   @default(now())
  shop            Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  printJobs       PrintJob[]
  printers        Printer[]

  @@index([shopId], map: "print_agents_shopId_fkey")
  @@map("print_agents")
}

model Printer {
  id                  String      @id @default(cuid())
  shopId              String
  agentId             String?
  windowsPrinterName  String
  displayName         String
  manufacturer        String?
  model               String?
  connectionType      String      @default("WINDOWS_SPOOLER")
  ipAddress           String?
  supportsColor       Boolean     @default(false)
  supportsDuplex      Boolean     @default(false)
  supportedPaperSizes String      @default("A4")
  status              String      @default("UNKNOWN")
  isActive            Boolean     @default(true)
  currentQueueCount   Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  printJobs           PrintJob[]
  agent               PrintAgent? @relation(fields: [agentId], references: [id])
  shop                Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([agentId], map: "printers_agentId_fkey")
  @@index([shopId], map: "printers_shopId_fkey")
  @@map("printers")
}

model PrintJob {
  id           String        @id @default(cuid())
  orderId      String
  documentId   String
  printerId    String?
  agentId      String?
  status       String        @default("PENDING")
  spoolerJobId Int?
  errorMessage String?       @db.Text
  dispatchedAt DateTime?
  completedAt  DateTime?
  createdAt    DateTime      @default(now())
  agent        PrintAgent?   @relation(fields: [agentId], references: [id])
  document     OrderDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  printer      Printer?      @relation(fields: [printerId], references: [id])

  @@index([agentId], map: "print_jobs_agentId_fkey")
  @@index([documentId], map: "print_jobs_documentId_fkey")
  @@index([orderId], map: "print_jobs_orderId_fkey")
  @@index([printerId], map: "print_jobs_printerId_fkey")
  @@map("print_jobs")
}

model PricingRule {
  id               String   @id @default(cuid())
  shopId           String
  paperSize        String   @default("A4")
  bwSinglePrice    Float    @default(2)
  bwDoublePrice    Float    @default(3)
  colorSinglePrice Float    @default(10)
  colorDoublePrice Float    @default(18)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  shop             Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, paperSize])
  @@map("pricing_rules")
}

model SubscriptionPlan {
  id               String         @id
  name             String
  monthlyPrice     Float
  yearlyPrice      Float
  maxPrinters      Int
  maxMonthlyOrders Int
  featuresJson     String         @db.Text
  createdAt        DateTime       @default(now())
  subscriptions    Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                 String           @id @default(cuid())
  shopId             String           @unique
  planId             String
  status             String           @default("TRIALING")
  trialStartAt       DateTime         @default(now())
  trialEndAt         DateTime
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime         @default(now())
  plan               SubscriptionPlan @relation(fields: [planId], references: [id])
  shop               Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([planId], map: "subscriptions_planId_fkey")
  @@map("subscriptions")
}

model AuditLog {
  id         String   @id @default(cuid())
  shopId     String?
  userId     String?
  action     String
  entityType String
  entityId   String
  details    String?  @db.Text
  ipAddress  String?
  createdAt  DateTime @default(now())
  shop       Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([shopId], map: "audit_logs_shopId_fkey")
  @@index([userId], map: "audit_logs_userId_fkey")
  @@map("audit_logs")
}

model DocumentStorage {
  id         String   @id @default(cuid())
  storageKey String   @unique @db.VarChar(512)
  fileData   Bytes
  mimeType   String   @default("application/pdf")
  filename   String
  fileSize   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("document_storage")
}
